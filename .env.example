# Public — safe in the browser (Supabase project URL + publishable/anon key)
NEXT_PUBLIC_SUPABASE_URL=https://ogehuqorluzhbfuygsjc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server only. Supabase Dashboard → Project Settings → API Keys → service_role / secret key.
# Needed to create and manage user logins. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Max upload size in MB. 50 on the Supabase free plan; raise after upgrading (and raise the bucket limit too).
NEXT_PUBLIC_MAX_UPLOAD_MB=50

# Random string; Vercel Cron sends it so only Vercel can call /api/keepalive.
CRON_SECRET=
